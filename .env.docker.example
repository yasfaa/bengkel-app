# ==============================================================================
# BengkelKu - Docker Environment Variables Template
# ==============================================================================
# Cara pakai local:
#   cp .env.docker.example .env.docker
#   (isi nilai lalu) docker compose --env-file .env.docker up --build
#
# Cara pakai production (di VPS):
#   cp .env.docker.example .env.prod
#   (isi nilai lalu) docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# Container Registry (Docker Hub)
# ──────────────────────────────────────────────────────────────────────────────
DOCKERHUB_USERNAME=your_dockerhub_username

# ──────────────────────────────────────────────────────────────────────────────
# MySQL Database
# ──────────────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=bengkel_db
MYSQL_USER=bengkel_user
MYSQL_PASSWORD=your_strong_db_password

# ──────────────────────────────────────────────────────────────────────────────
# Backend Application
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# JWT Secrets (gunakan string random panjang, min 32 karakter)
ACCESS_TOKEN_SECRET=your_very_long_and_random_access_token_secret
REFRESH_TOKEN_SECRET=your_very_long_and_random_refresh_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS (domain yang boleh akses backend, pisahkan dengan koma)
CORS_ORIGIN=http://localhost

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ──────────────────────────────────────────────────────────────────────────────
# Frontend / Nginx
# ──────────────────────────────────────────────────────────────────────────────
# Port yang dibuka di host untuk akses browser
FRONTEND_PORT=80
