datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id         Int       @id @default(autoincrement())
  nama       String
  telepon    String
  alamat     String?
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now()) @updatedAt
  vehicles   Vehicle[]
}

model MotorBrand {
  id         Int         @id @default(autoincrement())
  nama       String      @unique
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  types      MotorType[]
}

model EngineCapacity {
  id         Int         @id @default(autoincrement())
  kapasitas  String      @unique
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  types      MotorType[]
  vehicles   Vehicle[]
}

model MotorType {
  id                 Int             @id @default(autoincrement())
  nama               String
  brand_id           Int
  brand              MotorBrand      @relation(fields: [brand_id], references: [id])
  jenis              String          @default("matic") // matic, bebek, sport, naked
  engine_capacity_id Int?
  engineCapacity     EngineCapacity? @relation(fields: [engine_capacity_id], references: [id])
  created_at         DateTime        @default(now())
  updated_at         DateTime        @default(now()) @updatedAt
  vehicles           Vehicle[]

  @@unique([brand_id, nama])
}

model Vehicle {
  id                 Int            @id @default(autoincrement())
  customer_id        Int
  customer           Customer       @relation(fields: [customer_id], references: [id])
  nopol              String         @unique
  motor_type_id      Int
  motorType          MotorType      @relation(fields: [motor_type_id], references: [id])
  engine_capacity_id Int
  engineCapacity     EngineCapacity @relation(fields: [engine_capacity_id], references: [id])
  warna              String?
  tahun_pembuatan    Int?
  km_terakhir        Int            @default(0)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt
  services           Service[]
}

model Supplier {
  id         Int         @id @default(autoincrement())
  nama       String      @unique
  telepon    String?
  alamat     String?
  created_at DateTime    @default(now())
  updated_at DateTime    @default(now()) @updatedAt
  spareparts Sparepart[]
  stockIns   StockIn[]
}

model Sparepart {
  id           Int           @id @default(autoincrement())
  kode_part    String        @unique // e.g. "AHM-MPX2-08L"
  nama         String
  kategori     String        @default("FAST_MOVING") // FAST_MOVING, SLOW_MOVING, OLI, BAN
  stok         Int           @default(0)
  min_stok     Int           @default(5) // Reorder point
  harga_beli   Decimal       @db.Decimal(12, 2)
  harga_jual   Decimal       @db.Decimal(12, 2)
  supplier_id  Int?
  supplier     Supplier?     @relation(fields: [supplier_id], references: [id])
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now()) @updatedAt
  stockIns     StockIn[]
  serviceItems ServiceItem[]
}

model StockIn {
  id           Int       @id @default(autoincrement())
  sparepart_id Int
  sparepart    Sparepart @relation(fields: [sparepart_id], references: [id])
  supplier_id  Int?
  supplier     Supplier? @relation(fields: [supplier_id], references: [id])
  jumlah       Int
  tgl_masuk    DateTime  @default(now())
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
}

model ServiceMaster {
  id              Int           @id @default(autoincrement())
  nama            String        @unique
  harga           Decimal       @db.Decimal(12, 2)
  deskripsi       String?
  estimasi_durasi Int           @default(30) // dalam menit
  kategori        String        @default("RINGAN") // RINGAN, LENGKAP, BERAT, TUNE_UP, OLI
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now())
  updated_at      DateTime      @default(now()) @updatedAt
  services        Service[]
  serviceItems    ServiceItem[]
}

model Mechanic {
  id           Int       @id @default(autoincrement())
  user_id      Int       @unique
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  spesialisasi String    @default("Umum") // e.g. "Umum", "Mesin & CVT", "Kelistrikan & Injeksi"
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt
  services     Service[]
}

model Service {
  id                Int            @id @default(autoincrement())
  nomor_pkb         String?        @unique // e.g. PKB-20260818-001
  vehicle_id        Int
  vehicle           Vehicle        @relation(fields: [vehicle_id], references: [id])
  mechanic_id       Int?
  mechanic          Mechanic?      @relation(fields: [mechanic_id], references: [id])
  service_master_id Int?
  serviceMaster     ServiceMaster? @relation(fields: [service_master_id], references: [id])
  km_masuk          Int?           @default(0)
  level_bensin      String?        // e.g. "1/4", "1/2", "3/4", "Full"
  catatan_kondisi   String?        // e.g. "Spion lengkap, lecet bodi kiri"
  keluhan           String
  estimasi_biaya    Decimal?       @default(0) @db.Decimal(12, 2)
  estimasi_waktu    DateTime?
  status            String         // e.g. "Menunggu", "Dikerjakan", "Selesai"
  tgl_masuk         DateTime       @default(now())
  tgl_selesai       DateTime?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @default(now()) @updatedAt
  serviceItems      ServiceItem[]
  transactions      Transaction[]
  serviceQC         ServiceQC?
}

enum ItemType {
  SPAREPART
  JASA
}

enum ApprovalStatus {
  MENUNGGU_KONFIRMASI
  DISETUJUI
  DITOLAK
}

model ServiceItem {
  id                Int            @id @default(autoincrement())
  service_id        Int
  service           Service        @relation(fields: [service_id], references: [id])
  item_type         ItemType
  sparepart_id      Int?
  sparepart         Sparepart?     @relation(fields: [sparepart_id], references: [id])
  service_master_id Int?
  serviceMaster     ServiceMaster? @relation(fields: [service_master_id], references: [id])
  nama_item         String         // Snapshot nama suku cadang atau nama jasa
  quantity          Int            @default(1)
  harga_satuan      Decimal        @db.Decimal(12, 2)
  subtotal          Decimal        @db.Decimal(12, 2)
  approval_status   ApprovalStatus @default(MENUNGGU_KONFIRMASI)
  is_approved       Boolean        @default(false) // Sinkron dengan DISETUJUI
  catatan           String?        // Catatan diagnosa teknisi
  created_at        DateTime       @default(now())
  updated_at        DateTime       @default(now()) @updatedAt
}

model Transaction {
  id              Int      @id @default(autoincrement())
  no_invoice      String?  @unique // e.g. INV-260825-001
  service_id      Int
  service         Service  @relation(fields: [service_id], references: [id])
  total_jasa      Decimal  @default(0) @db.Decimal(12, 2)
  total_sparepart Decimal  @default(0) @db.Decimal(12, 2)
  diskon          Decimal  @default(0) @db.Decimal(12, 2)
  total           Decimal  @db.Decimal(12, 2)
  uang_diterima   Decimal? @default(0) @db.Decimal(12, 2)
  kembalian       Decimal? @default(0) @db.Decimal(12, 2)
  tgl_bayar       DateTime @default(now())
  metode_bayar    String   // e.g. Tunai, Transfer Bank BCA, Transfer Bank Mandiri, QRIS, Piutang Armada
  kasir_id        Int?
  kasir           User?    @relation(fields: [kasir_id], references: [id])
  catatan         String?  @db.Text
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
}

enum Role {
  ADMIN
  MEKANIK
  KEPALA_BENGKEL
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String?        @unique
  password      String         // Hash bcrypt
  nama          String
  tgl_lahir     DateTime?
  tgl_masuk     DateTime       @default(now())
  role          Role           @default(ADMIN)
  is_active     Boolean        @default(true)
  mechanic      Mechanic?
  refreshTokens RefreshToken[]
  serviceQCs    ServiceQC[]
  transactions  Transaction[]
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique @db.VarChar(500)
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())
}

model ServiceQC {
  id                    Int      @id @default(autoincrement())
  service_id            Int      @unique
  service               Service  @relation(fields: [service_id], references: [id], onDelete: Cascade)
  kelistrikan_ok        Boolean  @default(true)
  rem_ok                Boolean  @default(true)
  gas_ok                Boolean  @default(true)
  test_ride_ok          Boolean  @default(true)
  part_bekas_diserahkan Boolean  @default(true)
  catatan               String?  @db.Text
  qc_by_id              Int?
  qcBy                  User?    @relation(fields: [qc_by_id], references: [id])
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt
}
