# ==============================================================================
# BengkelKu Backend Environment Configuration
# ==============================================================================

# Server Network & Environment
PORT=3333
NODE_ENV=development

# Database Connection (MySQL / MariaDB)
DATABASE_URL="mysql://root:@localhost:3306/bengkel"

# Security & CORS Whitelist (Comma-separated origins)
CORS_ORIGIN="http://localhost:8080,http://127.0.0.1:8080"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
